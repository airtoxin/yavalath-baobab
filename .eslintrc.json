{
  "extends": "airbnb",
  "env": {
    "browser": true,
    "node": true,
    "es2021": true
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "rules": {
    "generator-star-spacing": "off",
    "import/no-extraneous-dependencies": ["error", {"devDependencies": true}],
    "react/jsx-filename-extension": "off",
    "react/prop-types": "off",
    "react/no-unused-prop-types": "off",
    "react/react-in-jsx-scope": "off"
  }
}
